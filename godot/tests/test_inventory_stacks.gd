extends SceneTree

const Stacks = preload("res://scripts/InventoryStacks.gd")

func _initialize() -> void:
    var bag = Stacks.new()
    assert(bag.slots.size() == 24)
    assert(bag.add("wood", 150) == 0)
    assert(bag.count("wood") == 150)
    assert(bag.slots[0]["count"] == 100)
    assert(bag.slots[1]["count"] == 50)
    assert(bag.move(1, 2, 20))
    assert(bag.slots[1]["count"] == 30)
    assert(bag.slots[2]["count"] == 20)
    assert(bag.split(0, 3))
    assert(bag.slots[0]["count"] == 50)
    assert(bag.slots[3]["count"] == 50)
    assert(bag.remove("wood", 40))
    assert(bag.count("wood") == 110)
    var snapshot: Array = bag.serialize()
    var restored = Stacks.new()
    assert(restored.restore(snapshot))
    assert(restored.count("wood") == 110)
    assert(not restored.restore([{"kind": "wood", "count": 999}]))
    var full = Stacks.new()
    assert(full.add("stone", 2400) == 0)
    assert(not full.can_fit("wood", 1))
    assert(full.add("wood", 1) == 1)
    print("InventoryStacks: OK")
    quit()
